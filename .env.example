# Copy this file to %LOCALAPPDATA%\OpenAI-Agent\secrets\agent.env.
# (The secret directory is shared with the Codex-side agent; both load the same file.)
# Optional. Journal generation does not use any API unless --api-summary is explicit.
ANTHROPIC_API_KEY=

# Set to 1 if @todo should be pushed to Google Tasks when --execute-commands runs.
GOOGLE_TODO_SYNC=1
GOOGLE_TASKS_CREDENTIALS=%LOCALAPPDATA%\OpenAI-Agent\secrets\credentials.json
GOOGLE_TASKS_TOKEN=%LOCALAPPDATA%\OpenAI-Agent\secrets\token_google_tasks.json
GOOGLE_TASKS_LIST_ID=@default
ONENOTE_NOTEBOOK_NAME=FarEasternTribe
ONENOTE_SECTION_NAME=日誌
